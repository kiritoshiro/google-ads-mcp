# Google OAuth client (Desktop app is simplest for one-user/private use)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Default Google Ads customer/account ID, digits only (no hyphens)
GOOGLE_ADS_CUSTOMER_ID=

# Optional manager account ID if the Ad Grant account is accessed through an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Current Google Ads API version. Update when Google retires this version.
GOOGLE_ADS_API_VERSION=v25

# MCP server. Keep 127.0.0.1 unless you intentionally put it behind a secured reverse proxy.
HOST=127.0.0.1
PORT=8787

# Write tools are present but disabled by default.
# Set to true only after read-only testing is complete.
ALLOW_WRITES=false

# Optional bearer token for MCP clients; keep secret and out of Git.
MCP_AUTH_TOKEN=
